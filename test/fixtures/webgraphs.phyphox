<phyphox xmlns="http://phyphox.org/xml" version="1.21">
    <title>Web graph test</title>
    <category>Test</category>
    <description>Exercises the remote interface graphs.</description>
    <data-containers>
        <container size="0">accX</container>
        <container size="0">accY</container>
        <container size="0">accZ</container>
        <container size="0">acc_time</container>
        <container size="0">acc</container>
        <container size="200">hist</container>
        <container size="200">histX</container>
        <container size="1">pickedX</container>
        <container size="1">assigned</container>
        <container size="1">pickedY</container>
        <container size="0">idx</container>
        <container size="0">temp</container>
        <container size="1" init="1.5">distance</container>
        <container size="1" init="2">height</container>
        <container size="1" init="0.5">length</container>
        <container size="1" init="42">percent</container>
        <container size="1" init="-10">lower</container>
        <container size="1" init="250">upper</container>
    </data-containers>
    <input>
        <sensor type="accelerometer" rate="50">
            <output component="x">accX</output>
            <output component="y">accY</output>
            <output component="z">accZ</output>
            <output component="t">acc_time</output>
        </sensor>
    </input>
    <analysis>
        <power>
            <input as="base" clear="false">accX</input>
            <input as="exponent" type="value">2</input>
            <output as="power">acc</output>
        </power>
        <add>
            <input clear="false">accX</input>
            <input type="value">20</input>
            <output>temp</output>
        </add>
    </analysis>
    <views>
        <view label="Graphs">
            <graph label="Acceleration (partial, 3 datasets)" labelX="t" unitX="@second" labelY="a" unitY="@meter_per_square_second" unitYperX="m/s³" partialUpdate="true">
                <input axis="x">acc_time</input>
                <input axis="y">accX</input>
                <input axis="x" color="green">acc_time</input>
                <input axis="y">accY</input>
                <input axis="x" color="blue" style="dots">acc_time</input>
                <input axis="y">accZ</input>
            </graph>
            <graph label="Follow x (5 s)" labelX="t" unitX="s" labelY="a" unitY="m/s²" partialUpdate="true" followX="true" minX="0" maxX="5" scaleMinY="fixed" minY="-15" scaleMaxY="fixed" maxY="15" lineWidth="2">
                <input axis="x">acc_time</input>
                <input axis="y">accX</input>
            </graph>
            <graph label="Picker (dots)" labelX="t" unitX="@second" labelY="a²" unitY="m²/s⁴" style="dots" partialUpdate="true" pickLabel="Calibrate">
                <input axis="x">acc_time</input>
                <input axis="y">acc</input>
                <output axis="x" label="Calibration point">pickedX</output>
                <output axis="xcal" label="Assigned wavelength in nm">assigned</output>
                <output axis="y" label="Pick y">pickedY</output>
            </graph>
            <value label="Picked x" size="1" precision="3" unit="s">
                <input>pickedX</input>
            </value>
            <value label="Assigned" size="1" precision="1" unit="nm">
                <input>assigned</input>
            </value>
            <value label="Picked y" size="1" precision="3">
                <input>pickedY</input>
            </value>
            <!-- logical units (file format 1.21): the same elements as in the mock's first view -->
            <value label="Distance" precision="2" unit="@meter">
                <input>distance</input>
            </value>
            <value label="Height" precision="1" unit="@foot">
                <input>height</input>
            </value>
            <edit label="Length" unit="@meter" min="0.1" max="2.0" default="0.5">
                <output>length</output>
            </edit>
            <graph label="Temperature" labelX="t" unitX="@second" labelY="T" unitY="@degree_celsius" partialUpdate="true">
                <input axis="x">acc_time</input>
                <input axis="y">temp</input>
            </graph>
            <graph label="Deprecated placeholder" labelX="t" unitX="[[unit_short_second]]" labelY="a" unitY="[[unit_short_meter_per_square_second]]" partialUpdate="true">
                <input axis="x">acc_time</input>
                <input axis="y">accX</input>
            </graph>
        </view>
        <view label="Second">
            <graph label="Log y" labelX="t" unitX="s" labelY="a²" unitY="m²/s⁴" logY="true" partialUpdate="true">
                <input axis="x">acc_time</input>
                <input axis="y">acc</input>
            </graph>
        </view>
        <!-- the drawing elements (file format 1.21): the same elements as in the mock's "Drawing" view, which
             follows phyphox-docs corpus/generated/view-drawing.phyphox plus a convertible scale under a needle -->
        <view label="Drawing">
            <stack>
                <geometry shape="circle" centerX="0.5" centerY="0.5" radius="0.48" color="202020" lineColor="ff7e22" lineWidth="0.01" />
                <geometry shape="arc" centerX="0.5" centerY="0.5" radius="0.45" innerRadius="0.4" startAngle="1.57" sweepAngle="0.79" color="fe005d80" />
                <scale shape="circular" min="0" max="100" ticStep="10" minorTics="4" centerX="0.5" centerY="0.5" radius="0.42"
                       startAngle="-2.3562" sweepAngle="4.7124" lineWidth="0.005" ticLength="-0.04" minorTicLength="-0.02"
                       valueEvery="2" valueDistance="-0.11" precision="0" size="0.8" color="white" valueOrientation="radial"
                       label="Load" unit="%" labelPositionX="0.5" labelPositionY="0.72" />
                <transform originX="0.5" originY="0.5">
                    <input as="rotate" min="0" max="100" mapMin="-2.3562" mapMax="2.3562" clamp="true">percent</input>
                    <geometry shape="line" startX="0.5" startY="0.5" endX="0.5" endY="0.12" lineColor="ff7e22" lineWidth="0.015" />
                </transform>
                <geometry shape="circle" radius="0.04" color="orange" />
                <value unit="%" size="2" align="center"><input>percent</input></value>
            </stack>
            <vertical>
                <geometry shape="rectangle" aspectRatio="4" left="0.05" top="0.2" right="0.95" bottom="0.6" cornerRadius="0.05" color="303030" lineColor="ff7e22" lineWidth="0.004" />
                <scale shape="linear" aspectRatio="4" min="-20" max="60" ticStep="10" minorTics="1" unit="@degree_celsius"
                       startX="0.05" startY="0.25" endX="0.95" endY="0.25"
                       ticLength="0.03" minorTicLength="0.015" valueDistance="0.08" label="Temperature" labelPositionX="0.5" labelPositionY="0.88" />
            </vertical>
            <horizontal>
                <geometry shape="line" startX="0.1" startY="0.9" endX="0.9" endY="0.1" color="blue" lineWidth="0.02" />
                <scale shape="linear" min="0" max="1" startX="0.5" startY="0.9" endX="0.5" endY="0.1" ticStep="0.25" unit="m/s²" weight="2" valueOrientation="tangential" />
            </horizontal>
            <grid maxWidth="20">
                <geometry />
                <scale shape="circular" min="0" max="360" ticStep="90" lineWidth="0" ticLength="0" valueEvery="0" sweepAngle="-6.2832" label="Heading" />
                <scale shape="circular" min="0" max="100" unit="@meter" valueOrientation="tangential" label="Range">
                    <input as="min">lower</input>
                    <input as="max">upper</input>
                </scale>
            </grid>
            <stack>
                <geometry shape="rectangle" aspectRatio="6" cornerRadius="0.08" color="303030" />
                <transform originX="0" originY="0.5">
                    <input as="scaleX" min="0" max="100" clamp="true">percent</input>
                    <geometry shape="rectangle" aspectRatio="6" cornerRadius="0.08" color="2bfb4c" />
                </transform>
                <transform>
                    <input as="rotate" min="0" max="360" mapMin="0" mapMax="6.2832">percent</input>
                    <scale shape="circular" aspectRatio="6" min="0" max="100" radius="0.05" />
                </transform>
                <scale aspectRatio="6" min="0" max="100" ticStep="25" startX="0" startY="0.5" endX="1" endY="0.5" ticLength="0.02" valueDistance="-0.05" unit="%" />
            </stack>
            <stack>
                <geometry shape="circle" radius="0.48" color="202020" />
                <scale shape="circular" min="0" max="10" unit="@meter" label="Distance" labelPositionX="0.5" labelPositionY="0.5" />
                <transform originX="0.5" originY="0.5">
                    <input as="rotate" min="0" max="100" mapMin="0" mapMax="3.14">percent</input>
                    <geometry shape="line" startX="0.5" startY="0.5" endX="0.5" endY="0.1" lineColor="ff7e22" lineWidth="0.02" />
                </transform>
                <transform>
                    <input as="opacity" min="0" max="100">percent</input>
                    <scale shape="linear" min="0" max="1" unit="@second" label="Time" labelPositionX="0.5" labelPositionY="0.9" />
                </transform>
                <geometry shape="circle" radius="0.04" color="orange" />
            </stack>
        </view>
    </views>
    <export>
        <set name="Data">
            <data name="t">acc_time</data>
            <data name="x">accX</data>
        </set>
    </export>
</phyphox>
